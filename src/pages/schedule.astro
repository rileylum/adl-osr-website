---
import Layout from '../layouts/Layout.astro';
import Schedule from '../components/Schedule.astro';
import { currentEvent } from '../data/events';
import { longDate } from '../lib/format';
---

<Layout
  title="Event Schedule - OZ ORC | Adelaide OSR Gaming Convention"
  description={`Full schedule for OZ ORC on ${longDate(currentEvent.date)} at ${currentEvent.venue.name}. Three gaming sessions with lunch and dinner breaks — doors open 8:30am, games run 9am to 8pm.`}
>
  <Schedule />
</Layout>
