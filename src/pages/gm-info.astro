---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import IconList from '../components/ui/IconList.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import FaqItem from '../components/ui/FaqItem.astro';
import { site } from '../data/site';
import { gmApplications, nextEventWindow } from '../data/events';
import { longDate } from '../lib/format';
---

<Layout
  title="GM Information - OZ ORC Adelaide | Resources for Game Masters"
  description="Essential information for Game Masters running games at OZ ORC. Find resources, safety tools, and what to bring to Adelaide's premier OSR gaming convention."
>
  <Section page>
    <SectionHeading
      as="h1"
      title="GM INFORMATION"
      subtitle="Resources and guidelines for Game Masters at OZ ORC"
    />

    <div class="space-y-12">
      <div>
        <SectionHeading title="Support & Resources" />
        <Card>
          <div class="mb-6">
            <h3 class="title-group mb-3">Safety Tools</h3>
            <p class="mb-4">
              In a convention environment, GMs will often be running games for
              strangers with varied backgrounds and experiences. If you're
              interested in learning about tools to help facilitate games in
              these situations, here are some excellent resources:
            </p>
            <IconList marker="arrow">
              <li>
                <a href="/code-of-conduct/" class="link">
                  OZ ORC Code of Conduct
                </a>
              </li>
              <li>
                <ExternalLink href="https://ttrpgsafetytoolkit.com">
                  TTRPG Safety Toolkit
                </ExternalLink>
              </li>
              <li>
                <ExternalLink href="https://slyflourish.com/safety_tools.html">
                  Sly Flourish's Guide to Safety Tools
                </ExternalLink>
              </li>
              <li>
                <ExternalLink
                  href="https://montecookgames.com/consent-in-gaming/"
                >
                  Monte Cook Games: Consent in Gaming
                </ExternalLink>
              </li>
            </IconList>
          </div>

          <div>
            <h3 class="title-group mb-3">Contact</h3>
            <p>
              If you have any questions or need assistance, please reach out to
              the organizers at{' '}
              <a href={`mailto:${site.email}`} class="link">
                {site.email}
              </a>
            </p>
          </div>
        </Card>
      </div>

      <div>
        <SectionHeading title="GM FAQ" />

        <div class="space-y-4">
          <FaqItem
            question="When and where is the next event?"
            group="gm-faq-accordion"
            open
          >
            <p>
              Adelaide, {nextEventWindow}. The exact date, venue and game slot
              times are still being confirmed. We'll share them with the GM
              mailing list and on our{' '}
              <ExternalLink href={site.socials.discord}>Discord</ExternalLink>{
                ' '
              }
              as soon as they're locked in.
              {
                gmApplications &&
                  ` GM applications close ${longDate(gmApplications.closes)}.`
              }
            </p>
          </FaqItem>

          <FaqItem question="Do GMs get free entry?" group="gm-faq-accordion">
            <p>Yes! GMs get free entry to the convention.</p>
          </FaqItem>

          <FaqItem
            question="What do I need to prepare?"
            group="gm-faq-accordion"
          >
            <p>
              Your scenario, plus anything else you need to run it. The standard
              is that GMs provide pre-generated characters. If your game needs
              something different, such as players rolling up characters at the
              table, tell us in the Description of your application.
            </p>
          </FaqItem>

          <FaqItem
            question="How many applications should I submit?"
            group="gm-faq-accordion"
          >
            <p>
              One for each session you'd like to run. In each application, tick
              every game slot you'd be happy to run that session in, and we'll
              confirm which one you get. If you'd like to run the same game
              twice, submit two applications.
            </p>
          </FaqItem>

          <FaqItem
            question={'Can I be a "standby" GM?'}
            group="gm-faq-accordion"
          >
            <p>
              Definitely! Fill in a{' '}
              <a href="/gm-submission/" class="link"> game application </a>{' '}
              and select "Standby" for your game slot. Standby games are called up
              if we get extra players or a GM has to pull out late.
            </p>
          </FaqItem>

          <FaqItem
            question="I don't have a name for my session but I have an idea. Can I still apply?"
            group="gm-faq-accordion"
          >
            <p>
              Yes! Put "TBA" in the Scenario field and tell us about your idea
              in the Description.
            </p>
          </FaqItem>

          <FaqItem
            question={'I don\'t know what to put for "Content Warnings". Can I still apply?'}
            group="gm-faq-accordion"
          >
            <p>
              You sure can. Put "Unsure" and our friendly team will help you
              work it out.
            </p>
          </FaqItem>

          <FaqItem
            question="I'm a GM who's unsure about running a game at OZ ORC. What should I do?"
            group="gm-faq-accordion"
          >
            <p>
              Join our{' '}
              <ExternalLink href={site.socials.discord}>Discord</ExternalLink>{
                ' '
              }
              and get talking with the community, or email{' '}
              <a href={`mailto:${site.gmEmail}`} class="link">
                {site.gmEmail}
              </a>{' '}
              to join the GM mailing list. We're very friendly and would love to help
              you figure out what's the best fit for you.
            </p>
          </FaqItem>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href="/gm-submission/" class="btn btn-primary btn-lg">
          Submit Your Game <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </Section>
</Layout>
