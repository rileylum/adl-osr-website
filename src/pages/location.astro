---
import Layout from '../layouts/Layout.astro';
import Location from '../components/Location.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { currentEvent, nextEventWindow } from '../data/events';
import { address } from '../lib/format';
---

<Layout
  title={currentEvent
    ? `Venue & Location - OZ ORC | ${currentEvent.venue.name}, Adelaide`
    : 'Venue & Location - OZ ORC | Adelaide OSR Gaming Convention'}
  description={currentEvent
    ? `OZ ORC takes place at the ${currentEvent.venue.name}, ${address(currentEvent.venue.address)}. View map, directions, and venue information.`
    : `The venue for OZ ORC ${nextEventWindow} will be announced once it's confirmed. Join the mailing list to hear first.`}
>
  {
    currentEvent ? (
      <Location event={currentEvent} />
    ) : (
      <ComingSoon title="LOCATION">
        The venue for OZ ORC {nextEventWindow} will be posted here once it's
        confirmed.
      </ComingSoon>
    )
  }
</Layout>
