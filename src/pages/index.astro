---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedGames from '../components/FeaturedGames.astro';
import CallForGames from '../components/CallForGames.astro';
import RegisterInterest from '../components/RegisterInterest.astro';
import About from '../components/About.astro';
import WhatToBring from '../components/WhatToBring.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import EventSchema from '../components/schemas/EventSchema.astro';
import { currentEvent, nextEventWindow } from '../data/events';
import { longDate } from '../lib/format';

const hasGames = (currentEvent?.games.length ?? 0) > 0;

const [title, description] = !currentEvent
  ? [
      `OZ ORC - Adelaide D&D & OSR Convention | Returning ${nextEventWindow}`,
      `Adelaide's premier old-school D&D, OSR and NSR gaming convention returns in ${nextEventWindow}. Join the mailing list and our Discord to hear first when dates and games are announced.`,
    ]
  : [
      `OZ ORC - Adelaide D&D & OSR Convention | ${longDate(currentEvent.date)}`,
      hasGames
        ? `Adelaide's premier old-school D&D, OSR and NSR gaming convention — ${longDate(currentEvent.date)} at ${currentEvent.venue.name}. Classic tabletop RPGs with expert GMs.`
        : `Adelaide's premier old-school D&D and OSR gaming convention returns ${longDate(currentEvent.date)} at ${currentEvent.venue.name}. GMs wanted — submit a game to run.`,
    ];
---

<Layout title={title} description={description} showLogo={false}>
  <div class="alternating-sections">
    <Hero />
    {
      currentEvent ? (
        <Fragment>
          {hasGames ? <FeaturedGames /> : <CallForGames />}
          <RegisterInterest />
        </Fragment>
      ) : (
        <Fragment>
          <RegisterInterest />
          <CallForGames />
        </Fragment>
      )
    }
    <About />
    <WhatToBring />
    <Testimonials />
    <FAQ />
  </div>
  {currentEvent && <EventSchema />}
</Layout>

<style is:global>
  /* Which sections render depends on the event state, so a colour hardcoded
     per section can put two of the same shade side by side. Alternate by
     position instead. `of :not(script)` skips the inline JSON-LD and module
     scripts some sections emit as siblings — plain :nth-child would count
     them and break the pattern. Sections must not set their own bg-base-*. */
  .alternating-sections > :nth-child(odd of :not(script)) {
    background-color: var(--color-base-200);
  }
  .alternating-sections > :nth-child(even of :not(script)) {
    background-color: var(--color-base-100);
  }
</style>
