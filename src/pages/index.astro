---
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import CommandBar from '../components/CommandBar.astro';
import GoldBox from '../components/GoldBox.astro';
import FeaturedGames from '../components/FeaturedGames.astro';
import CallForGames from '../components/CallForGames.astro';
import RegisterInterest from '../components/RegisterInterest.astro';
import About from '../components/About.astro';
import WhatToBring from '../components/WhatToBring.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import EventSchema from '../components/schemas/EventSchema.astro';
import {
  currentEvent,
  gmApplications,
  latestEvent,
  nextEventWindow,
} from '../data/events';
import { site } from '../data/site';
import { homeFunnel } from '../data/home';
import { longDate } from '../lib/format';

const funnel = homeFunnel({
  currentEvent,
  latestEvent,
  gmApplications,
  nextEventWindow,
  socials: site.socials,
});
const { hasGames } = funnel;

const [title, description] = !currentEvent
  ? [
      `OZ ORC - Adelaide D&D & OSR Convention | Returning ${nextEventWindow}`,
      `Adelaide's premier old-school D&D, OSR and NSR gaming convention returns in ${nextEventWindow}. Join the mailing list and our Discord to hear first when dates and games are announced.`,
    ]
  : [
      `OZ ORC - Adelaide D&D & OSR Convention | ${longDate(currentEvent.date)}`,
      hasGames
        ? `Adelaide's premier old-school D&D, OSR and NSR gaming convention — ${longDate(currentEvent.date)} at ${currentEvent.venue.name}. Classic tabletop RPGs with expert GMs.`
        : `Adelaide's premier old-school D&D and OSR gaming convention returns ${longDate(currentEvent.date)} at ${currentEvent.venue.name}. GMs wanted — submit a game to run.`,
    ];
---

<Layout title={title} description={description} showLogo={false}>
  <!-- Must match the cover logo's srcset and sizes (Cover.astro), or the
       browser preloads one width and then fetches another for the <img>. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/OZORC_Dungeon-500w.webp"
    imagesrcset="/images/OZORC_Dungeon-500w.webp 500w, /images/OZORC_Dungeon-800w.webp 800w, /images/OZORC_Dungeon.webp 1200w"
    imagesizes="(max-width: 859px) 230px, 560px"
    fetchpriority="high"
  />
  <!-- F's whole homepage body sits under one root, so a second look can hide
       it and mount its own markup in its place. -->
  <div class="home-f">
    <Cover funnel={funnel} />
    {
      currentEvent ? (
        <Fragment>
          {hasGames ? <FeaturedGames /> : <CallForGames />}
          <RegisterInterest />
        </Fragment>
      ) : (
        <Fragment>
          <RegisterInterest />
          <CallForGames />
        </Fragment>
      )
    }
    <About />
    <WhatToBring />
    <Testimonials />
    <FAQ />
    <CommandBar funnel={funnel} />
  </div>
  <GoldBox funnel={funnel} />
  {currentEvent && <EventSchema />}
</Layout>
