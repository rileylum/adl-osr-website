---
import { site, ogImageUrl } from '../../data/site';
import { currentEvent, eventStart, eventEnd } from '../../data/events';

const { venue, price } = currentEvent;

// startDate/endDate derive from the first and last agenda rows, so structured
// data can never drift from the timetable the page shows.
const startDate = eventStart(currentEvent);
const endDate = eventEnd(currentEvent);

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'OZ ORC 2026',
  description:
    "Adelaide's premier old-school D&D and OSR gaming convention. Experience classic tabletop RPGs with expert GMs, from original-edition D&D to weird sci-fi adventures.",
  startDate,
  endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: venue.schemaName,
    address: {
      '@type': 'PostalAddress',
      streetAddress: venue.address.street,
      addressLocality: venue.schemaLocality,
      addressRegion: venue.address.region,
      postalCode: venue.address.postcode,
      addressCountry: venue.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: venue.geo.lat,
      longitude: venue.geo.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  offers: {
    '@type': 'Offer',
    price: price.amount,
    priceCurrency: price.currency,
    url: site.url,
    availability: 'https://schema.org/InStock',
    validFrom: '2025-10-21',
  },
  performer: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  image: ogImageUrl,
  url: site.url,
};
---

<script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
