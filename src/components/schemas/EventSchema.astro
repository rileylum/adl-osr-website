---
import { site, ogImageUrl } from '../../data/site';
import { currentEvent } from '../../data/events';
import { iso } from '../../lib/format';

const { venue, date, utcOffset, price } = currentEvent;

// Clock times remain literal here until the agenda lands in issue 0004, at which
// point startDate/endDate derive from the first/last agenda rows. The date and
// offset already come from the event so the calendar day is single-sourced.
const startDate = iso(date, '09:00', utcOffset);
const endDate = iso(date, '21:30', utcOffset);

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'OZ ORC 2026',
  description:
    "Adelaide's premier old-school D&D and OSR gaming convention. Experience classic tabletop RPGs with expert GMs, from original-edition D&D to weird sci-fi adventures.",
  startDate,
  endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: venue.schemaName,
    address: {
      '@type': 'PostalAddress',
      streetAddress: venue.address.street,
      addressLocality: venue.schemaLocality,
      addressRegion: venue.address.region,
      postalCode: venue.address.postcode,
      addressCountry: venue.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: venue.geo.lat,
      longitude: venue.geo.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  offers: {
    '@type': 'Offer',
    price: price.amount,
    priceCurrency: price.currency,
    url: site.url,
    availability: 'https://schema.org/InStock',
    validFrom: '2025-10-21',
  },
  performer: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  image: ogImageUrl,
  url: site.url,
};
---

<script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
