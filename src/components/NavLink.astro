---
interface Props {
  text: string;
  url: string;
  disabled?: boolean;
}

const { text, url, disabled = false } = Astro.props;
---

<li class={disabled ? 'disabled' : ''}>
  {
    disabled ? (
      // A span, not an <a> without href: crawlers and Lighthouse flag
      // href-less anchors, and there's nowhere to go yet.
      <span class="opacity-50 cursor-not-allowed" title="Coming Soon">
        {text}
      </span>
    ) : (
      <a href={url}>{text}</a>
    )
  }
</li>
