---
// Homepage panel shown while there are no games to feature: either the current
// event has no confirmed games yet, or it is the off-season. Replaces the games
// carousel and funnels GMs to the submission form (event announced) or to
// Discord (off-season, submissions not open yet).
import DiscordIcon from '../assets/discord.svg?raw';
import { site } from '../data/site';
import { currentEvent, nextEventWindow } from '../data/events';
---

<section class="py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">GMS WANTED</h2>
    {
      currentEvent ? (
        <Fragment>
          <p class="text-lg mb-3">
            The game lineup is being assembled right now. We're recruiting Game
            Masters to run old-school and OSR games across our three sessions.
          </p>
          <p class="text-lg mb-8">
            Want to run a table? Submit your game below — confirmed games will
            appear here as they're locked in.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <p class="text-lg mb-3">
            Want to run a table at OZ ORC in {nextEventWindow}? We welcome GMs
            of every experience level.
          </p>
          <p class="text-lg mb-8">
            Game submissions open once the date is set. Join our Discord and
            tell us what you'd like to run — we'll let you know first.
          </p>
        </Fragment>
      )
    }
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/gm-submission" class="btn btn-primary btn-lg">
        {currentEvent ? 'Run a Game' : 'GM Submissions'}
      </a>
      <a
        href={site.socials.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-lg gap-2"
      >
        <Fragment set:html={DiscordIcon} />
        Join our Discord
      </a>
    </div>
  </div>
</section>
