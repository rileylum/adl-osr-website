---
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';
import IconList from './ui/IconList.astro';
---

<Section>
  <SectionHeading title="WHAT TO EXPECT" />

  <div class="grid md:grid-cols-2 gap-8">
    <Card title="What to Bring" titleAs="h3">
      <IconList marker="check">
        <li>Dice (standard polyhedral set)</li>
        <li>Pencils and paper for notes</li>
        <li>Your enthusiasm for adventure!</li>
        <li>Your own food and drinks (non-alcoholic)</li>
      </IconList>
    </Card>

    <Card title="What We Provide" titleAs="h3">
      <IconList marker="check">
        <li>Experienced Game Masters</li>
        <li>Pre-generated characters</li>
        <li>All rulebooks and materials</li>
        <!-- <li>Lunch and dinner</li> -->
      </IconList>
    </Card>
  </div>

  <div class="alert bg-raised shadow-sm mt-8">
    <div>
      <h4 class="title-group mb-2">First Time at an OSR Event?</h4>
      <p>
        Don't worry! Our GMs are experienced at welcoming new players. You don't
        need to know the rules or bring a character - just bring yourself and a
        willingness to explore strange worlds.
      </p>
    </div>
  </div>
</Section>
