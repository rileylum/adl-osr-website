---
import ExternalLink from './ui/ExternalLink.astro';
import type { Game } from '../data/games';

export interface Props {
  game: Game;
  variant?: 'featured' | 'compact';
}

const { game, variant = 'featured' } = Astro.props;
const { title, system, image, description, warhornUrl, gm, level, tags } = game;

// Responsive-image srcset rule — the width-suffix naming convention
// (-400w / -600w / -800w) is defined once, here, and both variants emit it.
const widthUrl = (w: number) => image.replace('.webp', `-${w}w.webp`);
const src = widthUrl(400);
const srcset = `${widthUrl(400)} 400w, ${widthUrl(600)} 600w, ${widthUrl(800)} 800w`;
const alt = `${title} - ${system} tabletop RPG module cover art for OZ ORC Adelaide`;
---

{
  variant === 'featured' ? (
    <div class="card bg-raised shadow-sm h-full flex flex-col">
      <figure class="aspect-video overflow-hidden">
        <img
          src={src}
          srcset={srcset}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 400px, 400px"
          alt={alt}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="card-body flex flex-col flex-1 max-[400px]:p-4">
        <h3 class="card-title text-2xl max-[400px]:text-xl mb-2">{title}</h3>
        <div class="flex flex-wrap gap-2 mb-3">
          <div class="badge badge-accent">{system}</div>
          {level && <div class="badge badge-primary">Level {level}</div>}
        </div>

        {gm && (
          <div class="text-sm text-base-content mb-3">
            <span class="font-semibold">GM:</span> {gm}
          </div>
        )}

        <div class="mb-4">
          <p class="line-clamp-4 text-base-content">{description}</p>
        </div>

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <span class="badge badge-primary">{tag}</span>
            ))}
          </div>
        )}

        <div class="mt-auto">
          <ExternalLink href={warhornUrl} class="btn btn-primary w-full">
            Sign Up on Warhorn
          </ExternalLink>
        </div>
      </div>
    </div>
  ) : (
    <ExternalLink href={warhornUrl} class="encounter encounter-compact">
      <img
        src={src}
        srcset={srcset}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt={title}
        width="800"
        height="450"
        loading="lazy"
      />
      <h3 class="encounter-title">
        <span class="sub-key" />
        {title}
      </h3>
      <p class="statline">
        <span>
          <b>System</b> {system}
        </span>{' '}
        {level && (
          <span>
            <b>Level</b> {level}
          </span>
        )}{' '}
        {gm && (
          <span>
            <b>GM</b> {gm}
          </span>
        )}
      </p>
    </ExternalLink>
  )
}

<style>
  /* A keyed encounter entry, as in a module's room key. :global because the
     root may be an ExternalLink, which doesn't take this file's scope. */
  :global(.encounter) {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background-color: var(--surface-raised);
    border: var(--border) solid var(--color-rule);
    padding: 0.75rem;
  }

  .encounter img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    border: var(--border) solid var(--color-rule);
  }

  .encounter-title {
    font-size: 1.55rem;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .statline {
    margin: 0;
    padding: 0.35rem 0;
    font-size: 1rem;
    line-height: 1.45;
    border-block: var(--border) solid var(--color-rule);
  }

  .statline b {
    font-family: var(--font-sans);
    font-variation-settings: 'wdth' 70;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-right: 0.15em;
  }

  .statline span {
    display: inline-block;
    max-width: 100%;
    margin-right: 0.9em;
  }

  /* The whole compact card is the link: text keeps the body colour, and
     hover marks the frame in the link colour. */
  :global(.encounter-compact) {
    color: var(--color-base-content);
    text-decoration: none;
  }

  :global(.encounter-compact:hover) {
    border-color: var(--color-link);
  }
</style>
