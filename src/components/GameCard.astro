---
import ExternalLink from './ui/ExternalLink.astro';
import type { Game } from '../data/games';

export interface Props {
  game: Game;
  variant?: 'featured' | 'compact';
}

const { game, variant = 'featured' } = Astro.props;
const { title, system, image, description, warhornUrl, gm, level } = game;

// Responsive-image srcset rule — the width-suffix naming convention
// (-400w / -600w / -800w) is defined once, here, and both variants emit it.
const widthUrl = (w: number) => image.replace('.webp', `-${w}w.webp`);
const src = widthUrl(400);
const srcset = `${widthUrl(400)} 400w, ${widthUrl(600)} 600w, ${widthUrl(800)} 800w`;
const alt = `${title} - ${system} tabletop RPG module cover art for OZ ORC Adelaide`;
const featured = variant === 'featured';

// Featured cards carry their own Sign Up button; a compact card is itself the
// link out, opened like ExternalLink's.
const Root = featured ? 'article' : 'a';
const rootProps = featured
  ? { class: 'encounter' }
  : {
      class: 'encounter encounter-compact',
      href: warhornUrl,
      target: '_blank',
      rel: 'noopener noreferrer',
    };
---

<Root {...rootProps}>
  <img
    src={src}
    srcset={srcset}
    sizes={featured
      ? '(max-width: 859px) 86vw, 360px'
      : '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw'}
    alt={featured ? alt : title}
    width="800"
    height="450"
    loading="lazy"
    decoding="async"
  />
  <h3 class="encounter-title">
    <span class="sub-key"></span>
    {title}
  </h3>
  <p class="statline">
    {
      [
        ['System', system],
        ['Level', level],
        ['GM', gm],
      ].map(
        ([label, value]) =>
          value && (
            <span>
              <b class="label-caps">{label}</b> {value}{' '}
            </span>
          )
      )
    }
  </p>
  {
    featured && (
      <Fragment>
        <p class="desc">{description}</p>
        <ExternalLink href={warhornUrl} class="btn btn-line">
          Sign Up on Warhorn <span aria-hidden="true">→</span>
        </ExternalLink>
      </Fragment>
    )
  }
</Root>

<style>
  /* A keyed encounter entry, as in a module's room key. */
  .encounter {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background-color: var(--surface-raised);
    border: var(--border) solid var(--color-rule);
    padding: 0.75rem;
  }

  .encounter img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    border: var(--border) solid var(--color-rule);
  }

  .encounter-title {
    font-size: 1.55rem;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .statline {
    margin: 0;
    padding: 0.35rem 0;
    font-size: 1rem;
    line-height: 1.45;
    border-block: var(--border) solid var(--color-rule);
  }

  .statline b {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-right: 0.15em;
  }

  .statline span {
    display: inline-block;
    max-width: 100%;
    margin-right: 0.9em;
  }

  .desc {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  /* A ruled button on the card's own surface; hover inverts it. */
  .encounter :global(.btn-line) {
    margin-top: auto;
    align-self: stretch;
    height: auto;
    min-height: 48px;
    background-color: var(--surface-raised);
    color: var(--color-base-content);
    border: var(--border) solid var(--color-rule);
    box-shadow: none;
  }

  .encounter :global(.btn-line:hover) {
    background-color: var(--color-base-content);
    color: var(--surface-raised);
  }

  /* The whole compact card is the link: text keeps the body colour, and
     hover marks the frame in the link colour. */
  .encounter-compact {
    color: var(--color-base-content);
    text-decoration: none;
  }

  .encounter-compact:hover {
    border-color: var(--color-link);
  }
</style>
