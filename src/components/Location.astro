---
import LocationIcon from '../assets/location.svg?raw';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';
import IconList from './ui/IconList.astro';
import type { Event } from '../data/events';
import { address } from '../lib/format';

interface Props {
  event: Event;
}

const { venue } = Astro.props.event;
const addressLine = address(venue.address);
---

<Section page>
  <SectionHeading as="h1" title="LOCATION">
    <div class="flex flex-col items-center justify-center gap-2">
      <div class="flex items-center gap-2">
        <Fragment set:html={LocationIcon} />
        <span>{venue.name}</span>
      </div>
      <span class="text-base-content/70">{addressLine}</span>
    </div>
  </SectionHeading>

  <div
    class="rounded-box overflow-hidden border border-base-content/5 bg-raised p-4"
  >
    <div class="w-full aspect-video">
      <iframe
        src={venue.mapEmbedUrl}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="rounded-lg"></iframe>
    </div>
    <div class="mt-4 text-left">
      <p class="text-lg font-semibold">{venue.name}</p>
      <p class="text-base-content/70">{addressLine}</p>
    </div>
  </div>

  <Card title="Getting Here" class="mt-8">
    <div class="mb-6">
      <h3 class="title-group mb-3">Parking</h3>
      <p>
        Street parking is available in the surrounding streets of Colonel Light
        Gardens.
      </p>
    </div>

    <div class="mb-6">
      <h3 class="title-group mb-3">Public Transport</h3>
      <p class="mb-2">
        The venue is approximately 7km south of Adelaide CBD and is accessible
        by public transport:
      </p>
      <IconList marker="arrow">
        <li>
          <strong>Bus:</strong> Routes 631, G10, G20, G21, 200, 200B, 200C service
          Colonel Light Gardens
        </li>
        <li>
          <strong>Train:</strong> Nearest stations are Mitcham and Torrens Park on
          the Belair line
        </li>
      </IconList>
    </div>

    <div>
      <h3 class="title-group mb-3">Contact Venue</h3>
      <p>
        For specific parking or accessibility questions, contact the venue
        directly at {venue.phone}
      </p>
    </div>
  </Card>
</Section>
