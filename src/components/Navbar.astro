---
import NavLink from './NavLink.astro';
import NavDropdown from './NavDropdown.astro';
import { currentEvent } from '../data/events';

interface Props {
  showLogo?: boolean;
}

const { showLogo = true } = Astro.props;
---

<!-- The black band across the top of a module; dark in both modes. -->
<header class="band relative z-10" data-look-only="f">
  <div class="max-w-7xl mx-auto w-full flex items-center gap-2 px-3 py-1.5">
    <!-- Below sm the name, logo and both menus don't fit in 320px, so the name
         goes and the logo, now first, is the home link. The homepage hides the
         logo (the cover shows it), which leaves room for the name down to
         375px; below that the homepage has no home link, which it doesn't
         need. -->
    <div
      class:list={[
        'flex-1',
        showLogo ? 'hidden sm:block' : 'hidden min-[375px]:block',
      ]}
    >
      <a
        href="/"
        class="label-caps no-underline whitespace-nowrap text-[.95rem]"
        >ADL OSR <span aria-hidden="true">//</span> OZ ORC</a
      >
    </div>
    {
      showLogo && (
        <div class="flex-none">
          <a href="/" class="block px-2">
            {/* Alt names where the link goes, not what the image looks like:
                on phones this is the only home link. The artwork is black
                line art and the band is dark in both modes, so it's always
                inverted. */}
            <img
              src="/images/OZORC_Dungeon.svg"
              alt="OZ ORC home"
              width="5000"
              height="2500"
              class="h-12 w-auto invert"
            />
          </a>
        </div>
      )
    }
    <nav class="flex-1 flex justify-end items-center gap-1.5" aria-label="Main">
      <NavDropdown title="ATTEND">
        <NavLink text="Code of Conduct" url="/code-of-conduct/" />
        <NavLink
          text="Event Signup"
          url={currentEvent?.warhornUrl ?? ''}
          disabled={!currentEvent?.warhornUrl}
        />
        <NavLink text="Event Schedule" url="/schedule/" />
        <NavLink text="Event Location" url="/location/" />
        <NavLink text="Gallery" url="/gallery/" />
      </NavDropdown>
      <!-- <NavDropdown title="INFO"> -->
      <!--   <NavLink text="What is OSR?" url="/what-is-osr" /> -->
      <!-- </NavDropdown> -->
      <NavDropdown title="GM'S" alignEnd={true}>
        <NavLink text="GM Info" url="/gm-info/" />
        <NavLink text="Game Submission" url="/gm-submission/" />
      </NavDropdown>
    </nav>
  </div>
</header>
