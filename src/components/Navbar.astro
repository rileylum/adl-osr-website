---
import NavLink from './NavLink.astro';
import NavDropdown from './NavDropdown.astro';
import { currentEvent } from '../data/events';

interface Props {
  showLogo?: boolean;
}

const { showLogo = true } = Astro.props;
---

<div class="navbar bg-base-100 shadow-sm">
  <div class="max-w-7xl mx-auto w-full flex items-center">
    <!-- Below sm the title, logo and both menus don't fit in 320px, so the
         title slot goes and the logo, now first, is the home link. The
         homepage hides the logo too (the hero shows it), leaving no home link
         there, which it doesn't need. -->
    <div class="hidden sm:block flex-1">
      <a href="/" class="btn btn-ghost text-xl">ADL OSR - OZ ORC</a>
    </div>
    {
      showLogo && (
        <div class="flex-none">
          <a
            href="/"
            class="block px-4 rounded-box focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            {/* Alt names where the link goes, not what the image looks like:
                on phones this is the only home link. */}
            <img
              src="/images/OZORC_Dungeon.svg"
              alt="OZ ORC home"
              width="5000"
              height="2500"
              class="h-12 w-auto logo-ink"
            />
          </a>
        </div>
      )
    }
    <div class="flex-1 flex justify-end items-center gap-1">
      <NavDropdown title="ATTEND">
        <NavLink text="Code of Conduct" url="/code-of-conduct" />
        <NavLink
          text="Event Signup"
          url={currentEvent?.warhornUrl ?? ''}
          disabled={!currentEvent?.warhornUrl}
        />
        <NavLink text="Event Schedule" url="/schedule" />
        <NavLink text="Event Location" url="/location" />
        <NavLink text="Gallery" url="/gallery" />
      </NavDropdown>
      <!-- <NavDropdown title="INFO"> -->
      <!--   <NavLink text="What is OSR?" url="/what-is-osr" /> -->
      <!-- </NavDropdown> -->
      <NavDropdown title="GM'S" alignEnd={true}>
        <NavLink text="GM Info" url="/gm-info" />
        <NavLink text="Game Submission" url="/gm-submission" />
      </NavDropdown>
    </div>
  </div>
</div>
