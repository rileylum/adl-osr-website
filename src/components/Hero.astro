---
import CalendarIcon from '../assets/calendar.svg?raw';
import LocationIcon from '../assets/location.svg?raw';
import DiscordIcon from '../assets/discord.svg?raw';
import FacebookIcon from '../assets/facebook.svg?raw';
import { site } from '../data/site';
import { currentEvent, nextEventWindow } from '../data/events';
import { longDate } from '../lib/format';

const event = currentEvent;
const warhornUrl = event?.warhornUrl;

// Three states: registration open, event announced but not open, off-season.
const [lead, sub, primaryLabel] = warhornUrl
  ? [
      "Ready to join Adelaide's premier old-school gaming convention?",
      'Sign up now or join our Discord community!',
      'Sign Up for Event',
    ]
  : event
    ? [
        "Adelaide's premier old-school gaming convention returns — and we're recruiting GMs now.",
        'Register your interest below, or join our Discord to stay in the loop!',
        'Register Your Interest',
      ]
    : [
        `Adelaide's premier old-school gaming convention returns in ${nextEventWindow}.`,
        'Join the mailing list to hear first when the date and games are announced, and come hang out on our Discord in the meantime.',
        'Join the Mailing List',
      ];
---

<div class="hero min-h-screen">
  <div class="hero-content text-center">
    <div class="max-w-2xl">
      <div>
        <img
          src="/images/OZORC_Dungeon-500w.webp"
          srcset="/images/OZORC_Dungeon-500w.webp 500w, /images/OZORC_Dungeon-800w.webp 800w, /images/OZORC_Dungeon.webp 1200w"
          sizes="(max-width: 768px) 100vw, 448px"
          alt="OZ ORC Logo"
          width="500"
          height="250"
          fetchpriority="high"
          class="w-full max-w-md mx-auto banner-logo"
        />
      </div>
      <h1 class="text-5xl font-bold mb-4">
        OZ ORC: Adelaide's <span class="whitespace-nowrap">Old-School</span> D&D &
        OSR Convention{event ? ` ${event.date.slice(0, 4)}` : ''}
      </h1>
      <div class="py-4 flex flex-col items-center justify-center gap-2">
        {
          event ? (
            <Fragment>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <div class="flex items-center gap-2">
                  <Fragment set:html={CalendarIcon} />
                  <span>{longDate(event.date)}</span>
                </div>
                <div class="flex items-center gap-2">
                  <Fragment set:html={LocationIcon} />
                  <span>{event.venue.name}</span>
                </div>
              </div>
              <div class="text-lg font-semibold">
                <span class="text-primary">
                  Tickets: ${event.price.amount} {event.price.currency}
                </span>
              </div>
            </Fragment>
          ) : (
            <div class="flex items-center gap-2">
              <Fragment set:html={CalendarIcon} />
              <span>Next event: {nextEventWindow} — date TBC</span>
            </div>
          )
        }
      </div>
      <div>
        <p class="text-lg mb-3">{lead}</p>
        <p class="text-lg mb-5">{sub}</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={warhornUrl || '#register'}
          target={warhornUrl ? '_blank' : undefined}
          rel={warhornUrl ? 'noopener noreferrer' : undefined}
          class="btn btn-primary"
        >
          {primaryLabel}
        </a>
        <a
          href={site.socials.discord}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary gap-2"
        >
          <Fragment set:html={DiscordIcon} />
          Join Discord
        </a>
        {
          event?.facebookEventUrl && (
            <a
              href={event.facebookEventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary gap-2"
            >
              <Fragment set:html={FacebookIcon} />
              Follow on Facebook
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .banner-logo {
    width: 100%;
    height: auto;
  }

  /* Invert the SVG colors in dark mode */
  @media (prefers-color-scheme: dark) {
    .banner-logo {
      filter: invert(1);
    }
  }

  /* For DaisyUI dark theme */
  [data-theme='dark'] .banner-logo {
    filter: invert(1);
  }
</style>
