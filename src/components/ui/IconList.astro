---
// Bulleted list with a glyph marker in the rule colour. Items are plain <li>s
// in the slot, so they can hold links and inline markup.
interface Props {
  marker: 'check' | 'arrow';
}

const glyphs = { check: '✓', arrow: '→' };
const { marker } = Astro.props;
---

<ul
  class="icon-list space-y-2"
  style={`--marker: '${glyphs[marker]}'`}
  data-ui="icon-list"
>
  <slot />
</ul>

<style>
  /* Absolute marker rather than a flex row: flex would turn each text run and
     inline element in an item into its own flex item and gap them apart. */
  .icon-list :global(li) {
    position: relative;
    padding-left: 1.5em;
  }

  .icon-list :global(li)::before {
    content: var(--marker);
    position: absolute;
    left: 0;
    color: var(--color-rule);
  }
</style>
