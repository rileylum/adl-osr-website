---
// Link that leaves the site: new tab, no opener or referrer. Defaults to the
// inline link style; pass `class` to style it as a button instead.
interface Props {
  href: string;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  class: className = 'link',
  'aria-label': ariaLabel,
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={className}
  aria-label={ariaLabel}><slot /></a
>
