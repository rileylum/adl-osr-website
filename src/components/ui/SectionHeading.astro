---
// The block that opens a page or section, in two shapes.
// h1: the page's cover strip — an orange, double-ruled band with the module
//   code, like a smaller homepage cover. No dragon: the art is homepage only.
// h2: a keyed heading — "1. TITLE" over a heavy rule. The number is a CSS
//   counter, so it follows whichever sections render in the current event
//   state. `.sub-key` chips after it count on from it ("1a", "1b").
// Extra content (event date and venue, etc.) goes in the slot below the
// subtitle.
import { site } from '../../data/site';

interface Props {
  title: string;
  as?: 'h1' | 'h2';
  subtitle?: string;
}

const { title, as: Tag = 'h2', subtitle } = Astro.props;
---

{
  Tag === 'h1' ? (
    <div class="cover-strip cover-frame" data-ui="page-title">
      <div class="module-code mb-2">
        <span class="label-caps">Convention Module</span>
        <span>{site.edition}</span>
      </div>
      <h1 class="title-page">{title}</h1>
      {subtitle && <p class="text-lg mt-3 font-semibold">{subtitle}</p>}
      {Astro.slots.has('default') && (
        <div class="mt-4">
          <slot />
        </div>
      )}
    </div>
  ) : (
    <div class="keyed mb-8" data-ui="section-title">
      <h2 class="title-section keyed-title">{title}</h2>
      {subtitle && <p class="text-lg text-(--color-muted) mt-3">{subtitle}</p>}
      <slot />
    </div>
  )
}

<style>
  .cover-strip {
    padding: 1rem 1.25rem 1.5rem;
    margin-bottom: 3rem;
    /* Break out of the Section's text column to the cover's width (1200px,
       with the cover's .6rem gutter), and pull up into the Section's top
       padding so the strip sits under the navbar as the cover does. Assumes
       the strip opens a <Section page>. */
    margin-inline: calc(50% - min(600px, 50vw - 0.6rem));
    margin-top: calc(0.6rem - var(--spacing-section));
  }

  @media (width >= 860px) {
    .cover-strip {
      padding: 1.4rem 2.25rem 2.25rem;
      margin-top: calc(1.5rem - var(--spacing-section));
    }
  }

  .keyed {
    counter-increment: key;
    counter-reset: sub;
  }

  .keyed-title {
    border-bottom: var(--rule-heavy) solid var(--color-rule);
    padding-bottom: 0.35rem;
  }

  .keyed-title::before {
    content: counter(key) '.';
    display: inline-block;
    background-color: var(--color-spot);
    color: var(--color-spot-content);
    padding: 0.04em 0.14em 0;
    margin-right: 0.3em;
  }
</style>
