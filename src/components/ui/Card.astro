---
// Content box on a raised surface: square, ruled, no shadow. Use for prose and
// lists; GameCard and the gallery tiles are media cards with their own frames.
interface Props {
  title?: string;
  titleAs?: 'h2' | 'h3';
  class?: string;
}

const { title, titleAs: Title = 'h2', class: className } = Astro.props;
---

<div
  class:list={[
    'bg-raised border-(length:--border) border-(--color-rule) p-6 sm:p-8',
    className,
  ]}
>
  {title && <Title class="title-card mb-4">{title}</Title>}
  <slot />
</div>
