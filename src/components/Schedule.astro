---
import CalendarIcon from '../assets/calendar.svg?raw';
import LocationIcon from '../assets/location.svg?raw';
import { sessionGroups, type Event } from '../data/events';
import { mil, friendly, longDate } from '../lib/format';
import GameCard from './GameCard.astro';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  event: Event;
}

const { agenda, games, venue, date } = Astro.props.event;
const sessions = sessionGroups(agenda, games);
---

<Section page as="div" width="full">
  <SectionHeading as="h1" title="OZ ORC SCHEDULE">
    <div class="flex items-center justify-center flex-wrap gap-4">
      <div class="flex items-center gap-2">
        <Fragment set:html={CalendarIcon} />
        <span>{longDate(date)}</span>
      </div>
      <div class="flex items-center gap-2">
        <Fragment set:html={LocationIcon} />
        <span>{venue.name}</span>
      </div>
    </div>
  </SectionHeading>

  <div class="max-w-2xl mx-auto mb-16">
    <div
      class="overflow-x-auto rounded-box border border-base-content/5 bg-raised"
    >
      <table class="table table-zebra">
        <thead>
          <tr>
            <th class="text-lg">Event</th>
            <th class="text-lg">Time</th>
          </tr>
        </thead>
        <tbody>
          {
            agenda.map((row) => (
              <tr>
                <td>
                  {row.sessionNumber !== undefined && games.length > 0 ? (
                    <a
                      href={`#session-${row.sessionNumber}`}
                      class="link link-hover"
                      set:text={row.label}
                    />
                  ) : (
                    row.label
                  )}
                </td>
                <td>
                  {row.end
                    ? `${mil(row.start)} - ${mil(row.end)}`
                    : `${mil(row.start)} - Close`}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="space-y-12">
    {
      games.length === 0 ? (
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="title-subsection mb-4">Games To Be Announced</h2>
          <p class="text-lg mb-6">
            We're still assembling the lineup for this event. Games will be
            listed here under each session as they're confirmed.
          </p>
          <a href="/gm-submission" class="btn btn-primary">
            Run a Game
          </a>
        </div>
      ) : (
        sessions.map((session) => (
          <section id={`session-${session.sessionNumber}`}>
            <h2 class="title-subsection mb-6 text-center">
              Session {session.sessionNumber}{' '}
              <span class="text-base-content/60 text-xl">
                ({friendly(session.start)} - {friendly(session.end)})
              </span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {session.games.map((game) => (
                <GameCard game={game} variant="compact" />
              ))}
            </div>
          </section>
        ))
      )
    }
  </div>
</Section>
