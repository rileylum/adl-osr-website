---
import CalendarIcon from '../assets/calendar.svg?raw';
import LocationIcon from '../assets/location.svg?raw';
import { currentEvent, sessionGroups } from '../data/events';
import { mil, friendly, longDate } from '../lib/format';

const { agenda, games, venue, date } = currentEvent;
const sessions = sessionGroups(agenda, games);
---

<div class="bg-base-200 py-16">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold">OZ ORC SCHEDULE</h1>
      <div class="py-6 flex items-center justify-center flex-wrap gap-4">
        <div class="flex items-center gap-2">
          <Fragment set:html={CalendarIcon} />
          <span>{longDate(date)}</span>
        </div>
        <div class="flex items-center gap-2">
          <Fragment set:html={LocationIcon} />
          <span>{venue.name}</span>
        </div>
      </div>
    </div>

    <div class="max-w-2xl mx-auto mb-16">
      <div
        class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100"
      >
        <table class="table table-zebra">
          <thead>
            <tr>
              <th class="text-lg">Event</th>
              <th class="text-lg">Time</th>
            </tr>
          </thead>
          <tbody>
            {
              agenda.map((row) => (
                <tr>
                  <td>
                    {row.sessionNumber !== undefined ? (
                      <a
                        href={`#session-${row.sessionNumber}`}
                        class="link link-hover"
                        set:text={row.label}
                      />
                    ) : (
                      row.label
                    )}
                  </td>
                  <td>
                    {row.end
                      ? `${mil(row.start)} - ${mil(row.end)}`
                      : `${mil(row.start)} - Close`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="space-y-12">
      {
        sessions.map((session) => (
          <section id={`session-${session.sessionNumber}`}>
            <h2 class="text-3xl font-bold mb-6 text-center">
              Session {session.sessionNumber}{' '}
              <span class="text-base-content/60 text-xl">
                ({friendly(session.start)} - {friendly(session.end)})
              </span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {session.games.map((game) => (
                <a
                  href={game.warhornUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card bg-base-100 shadow-sm hover:shadow-lg transition-shadow"
                >
                  <figure class="aspect-video overflow-hidden">
                    <img
                      src={game.image.replace('.webp', '-400w.webp')}
                      alt={game.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </figure>
                  <div class="card-body p-4">
                    <h3 class="card-title text-lg">{game.title}</h3>
                    <div class="flex flex-wrap gap-2">
                      <span class="badge badge-accent badge-sm">
                        {game.system}
                      </span>
                      {game.level && (
                        <span class="badge badge-primary badge-sm">
                          Level {game.level}
                        </span>
                      )}
                    </div>
                    {game.gm && (
                      <p class="text-sm text-base-content/70">GM: {game.gm}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</div>
