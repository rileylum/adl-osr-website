---
import CalendarIcon from '../assets/calendar.svg?raw';
import LocationIcon from '../assets/location.svg?raw';
import { sessionGroups, type Event } from '../data/events';
import { mil, friendly, longDate } from '../lib/format';
import GameCard from './GameCard.astro';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  event: Event;
}

const { agenda, games, venue, date } = Astro.props.event;
const sessions = sessionGroups(agenda, games);
---

<Section page as="div" width="wide">
  <SectionHeading as="h1" title="OZ ORC SCHEDULE">
    <div class="flex items-center flex-wrap gap-x-6 gap-y-2 font-semibold">
      <div class="flex items-center gap-2">
        <Fragment set:html={CalendarIcon} />
        <span>{longDate(date)}</span>
      </div>
      <div class="flex items-center gap-2">
        <Fragment set:html={LocationIcon} />
        <span>{venue.name}</span>
      </div>
    </div>
  </SectionHeading>

  <div class="max-w-2xl mb-16">
    <SectionHeading title="Agenda" />
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Event</th>
            <th scope="col">Time</th>
          </tr>
        </thead>
        <tbody>
          {
            agenda.map((row) => (
              <tr>
                <td>
                  {row.sessionNumber !== undefined && games.length > 0 ? (
                    <a
                      href={`#session-${row.sessionNumber}`}
                      class="link"
                      set:text={row.label}
                    />
                  ) : (
                    row.label
                  )}
                </td>
                <td class="font-display text-lg whitespace-nowrap">
                  {row.end
                    ? `${mil(row.start)} - ${mil(row.end)}`
                    : `${mil(row.start)} - Close`}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="space-y-16">
    {
      games.length === 0 ? (
        <div class="max-w-2xl">
          <SectionHeading title="Games To Be Announced" />
          <p class="text-lg mb-6">
            We're still assembling the lineup for this event. Games will be
            listed here under each session as they're confirmed.
          </p>
          <a href="/gm-submission/" class="btn btn-primary">
            Run a Game
          </a>
        </div>
      ) : (
        sessions.map((session) => (
          <section id={`session-${session.sessionNumber}`}>
            <SectionHeading
              title={`Session ${session.sessionNumber} — ${friendly(session.start)}–${friendly(session.end)}`}
            />
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {session.games.map((game) => (
                <GameCard game={game} variant="compact" />
              ))}
            </div>
          </section>
        ))
      )
    }
  </div>
</Section>
