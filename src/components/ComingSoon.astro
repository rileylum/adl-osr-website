---
// Off-season placeholder for event pages (Schedule, Location) whose content
// doesn't exist until the next event is set. The slot holds the message; the
// mailing list and Discord are the off-season funnels.
import DiscordIcon from '../assets/discord.svg?raw';
import ExternalLink from './ui/ExternalLink.astro';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { site } from '../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Section page width="text">
  <SectionHeading as="h1" title={title} />
  <div class="read-aloud">
    <p class="text-lg"><slot /></p>
  </div>
  <div class="flex flex-col sm:flex-row gap-4 mt-8">
    <a href="/#register" class="btn btn-primary">Join the Mailing List</a>
    <ExternalLink href={site.socials.discord} class="btn btn-outline gap-2">
      <Fragment set:html={DiscordIcon} />
      Join our Discord
    </ExternalLink>
  </div>
</Section>
