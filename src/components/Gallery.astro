---
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { gallerySections, galleryLeadCount } from '../data/gallery';
---

<Section page width="wide">
  <SectionHeading
    as="h1"
    title="PHOTOS FROM PAST EVENTS"
    subtitle="Relive the excitement from previous OZ ORC conventions"
  />

  {
    gallerySections.map((section, sectionIndex) => (
      <div class="mb-16">
        <SectionHeading title={section.title} />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {section.photos.map((photo, photoIndex) => (
            <a
              href={photo.src}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden bg-raised border-(length:--border) border-(--color-rule)"
            >
              {/* The square crop cuts off people at the edges, so the tile
                    links to the full photo. */}
              <figure class="aspect-square">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width="959"
                  height="722"
                  loading={
                    sectionIndex === 0 && photoIndex < galleryLeadCount
                      ? 'eager'
                      : 'lazy'
                  }
                  decoding="async"
                  class="w-full h-full object-cover motion-safe:transition-transform motion-safe:duration-300 motion-safe:hover:scale-105"
                />
              </figure>
            </a>
          ))}
        </div>
      </div>
    ))
  }

  <div>
    <a href="/" class="btn btn-primary">Back to Main Page</a>
  </div>
</Section>
