---
import { site } from '../data/site';
import { currentEvent } from '../data/events';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
}

const {
  title,
  description,
  image = site.ogImage,
  type = 'website',
  canonical,
} = Astro.props;

const siteUrl = Astro.site || site.url;
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;

const siteName = site.seoName;

// Geo tags derive from the current event's venue coordinates and the org
// locality — the coordinates are typed once on the venue. The 6-decimal
// formatting preserves the existing tag values exactly.
const { geo } = currentEvent.venue;
const lat = geo.lat.toFixed(6);
const lng = geo.lng.toFixed(6);
const geoRegion = `${site.address.country}-${site.address.region}`;
const geoPlacename = site.address.locality;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Geo Meta Tags for Adelaide Local SEO -->
<meta name="geo.region" content={geoRegion} />
<meta name="geo.placename" content={geoPlacename} />
<meta name="geo.position" content={`${lat};${lng}`} />
<meta name="ICBM" content={`${lat}, ${lng}`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_AU" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
