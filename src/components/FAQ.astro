---
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import FaqItem from './ui/FaqItem.astro';
import RichText from './ui/RichText.astro';
import { currentEvent, gmApplications, latestEvent } from '../data/events';
import { site } from '../data/site';
import { homeFaqs, faqPageSchema } from '../data/faq';

const faqs = homeFaqs({
  currentEvent,
  latestEvent,
  gmApplications,
  discordUrl: site.socials.discord,
});
---

<Section>
  <SectionHeading title="FREQUENTLY ASKED QUESTIONS" />

  <div class="space-y-4">
    {
      faqs.map((faq, i) => (
        <FaqItem question={faq.question} group="faq-accordion" open={i === 0}>
          <p>
            <RichText parts={faq.answer} />
          </p>
        </FaqItem>
      ))
    }
  </div>
</Section>

<script
  type="application/ld+json"
  set:html={JSON.stringify(faqPageSchema(faqs))}
/>
