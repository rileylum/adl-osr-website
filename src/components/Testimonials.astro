---
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';
---

<Section>
  <SectionHeading title="WHAT ATTENDEES SAY" />

  <div class="grid gap-6">
    <Card>
      <p class="text-lg italic mb-4">
        "Was great meeting you all! Just ran my first game last night and
        enjoyed the chaos. Looking forward to gaining more experience. Seeing
        the vibe at the last event, I know it's not as intimidating as one might
        imagine."
      </p>
      <div class="text-sm text-base-content/70">— Will</div>
    </Card>
  </div>
</Section>
