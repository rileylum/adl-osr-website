---
import { currentEvent } from '../data/events';
import GameCard from './GameCard.astro';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';

// index.astro renders this only while the current event has games.
const games = currentEvent?.games ?? [];
---

<Section id="games" width="wide">
  <SectionHeading title="Featured Games" />
  <div class="encounters">
    {games.map((game) => <GameCard game={game} variant="featured" />)}
  </div>
</Section>

<style>
  /* Keyed encounters: a swipe row on phones, scrolling inside itself so the
     page never scrolls sideways; a 3-up grid on desktop. */
  .encounters {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
  }

  .encounters > :global(*) {
    scroll-snap-align: start;
  }

  @media (min-width: 860px) {
    .encounters {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      gap: 1.5rem;
    }
  }
</style>
