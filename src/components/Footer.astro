---
import DiscordIcon from '../assets/discord.svg?raw';
import FacebookIcon from '../assets/facebook.svg?raw';
import InstagramIcon from '../assets/instagram.svg?raw';
import BlueskyIcon from '../assets/bluesky.svg?raw';
import ExternalLink from './ui/ExternalLink.astro';
import { site } from '../data/site';

const socials = [
  { href: site.socials.discord, label: 'Join our Discord', icon: DiscordIcon },
  {
    href: site.socials.facebook,
    label: 'Follow us on Facebook',
    icon: FacebookIcon,
  },
  {
    href: site.socials.instagram,
    label: 'Follow us on Instagram',
    icon: InstagramIcon,
  },
  {
    href: site.socials.bluesky,
    label: 'Follow us on Bluesky',
    icon: BlueskyIcon,
  },
];
---

<!-- The module's back cover. Built on plain flex rather than daisyUI's footer
     classes: footer-center lays its children side by side, which once made
     the whole page scroll sideways on phones. -->
<footer class="band site-footer" data-look-only="f">
  <div class="max-w-[1120px] mx-auto px-4 py-8 text-center">
    <ul class="flex justify-center gap-2.5 mb-4">
      {
        socials.map(({ href, label, icon }) => (
          <li>
            <ExternalLink href={href} class="social" aria-label={label}>
              <Fragment set:html={icon} />
            </ExternalLink>
          </li>
        ))
      }
    </ul>
    <p class="my-1">
      Contact us: <a href={`mailto:${site.email}`} class="link">{site.email}</a>
    </p>
    <p class="my-1">
      © {new Date().getFullYear()} OZ ORC. All rights reserved.
    </p>
    <span class="code-mark" aria-hidden="true">{site.edition}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  .site-footer :global(.social) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: var(--border) solid var(--band-content);
    color: var(--band-content);
  }

  .site-footer :global(.social:hover) {
    background-color: var(--band-content);
    color: var(--band-bg);
  }

  .code-mark {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.06em;
    background-color: var(--band-content);
    color: var(--band-bg);
    padding: 0.05rem 0.5rem;
  }
</style>
