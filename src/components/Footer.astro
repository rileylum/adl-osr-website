---
import DiscordIcon from '../assets/discord.svg?raw';
import FacebookIcon from '../assets/facebook.svg?raw';
import InstagramIcon from '../assets/instagram.svg?raw';
import BlueskyIcon from '../assets/bluesky.svg?raw';
import { site } from '../data/site';
---

<footer class="footer footer-center bg-base-200 text-base-content p-10">
  <div>
    <div class="flex gap-4">
      <a
        href={site.socials.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-circle btn-ghost"
        aria-label="Join our Discord"
      >
        <Fragment set:html={DiscordIcon} />
      </a>
      <a
        href={site.socials.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-circle btn-ghost"
        aria-label="Follow us on Facebook"
      >
        <Fragment set:html={FacebookIcon} />
      </a>
      <a
        href={site.socials.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-circle btn-ghost"
        aria-label="Follow us on Instagram"
      >
        <Fragment set:html={InstagramIcon} />
      </a>
      <a
        href={site.socials.bluesky}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-circle btn-ghost"
        aria-label="Follow us on Bluesky"
      >
        <Fragment set:html={BlueskyIcon} />
      </a>
    </div>
  </div>
  <div>
    <p class="mb-2">
      Contact us: <a href={`mailto:${site.email}`} class="link link-primary"
        >{site.email}</a
      >
    </p>
    <p>© {new Date().getFullYear()} OZ ORC. All rights reserved.</p>
  </div>
</footer>
