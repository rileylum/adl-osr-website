---
// A navbar menu. daisyUI's dropdown-hover opens on hover and on focus with no
// script; the look is the prototype's square, band-coloured menu.
interface Props {
  title: string;
  alignEnd?: boolean;
}

const { title, alignEnd = false } = Astro.props;
---

<div
  class={`nav-menu dropdown dropdown-hover ${alignEnd ? 'dropdown-end' : 'dropdown-bottom'}`}
>
  <div tabindex="0" role="button" class="trigger label-caps">{title}</div>
  <ul
    tabindex="-1"
    class={`dropdown-content menu z-[1] w-fit min-w-max p-0 ${alignEnd ? '' : 'left-1/2 -translate-x-1/2'}`}
  >
    <slot />
  </ul>
</div>

<style>
  .trigger {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    border: var(--border) solid var(--band-content);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .trigger::after {
    content: '\2193';
    margin-left: 0.35em;
    font-weight: 900;
  }

  .nav-menu:hover .trigger,
  .nav-menu:focus-within .trigger {
    background-color: var(--band-content);
    color: var(--band-bg);
  }

  .menu {
    margin-top: 4px;
    background-color: var(--band-bg);
    color: var(--band-content);
    border: var(--border) solid var(--band-content);
  }

  /* An invisible bridge over the 4px gap and the top border. dropdown-hover
     closes the menu the moment the pointer leaves .nav-menu, and without this
     the gap sits outside it, so the menu shut on the way down to an option.
     Keep its height in step with margin-top above. */
  .menu::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: calc(4px + var(--border));
  }

  .menu :global(li + li) {
    border-top: 1px solid var(--band-content);
  }

  .menu :global(a),
  .menu :global(li > span) {
    display: block;
    padding: 0.65rem 1rem;
    color: var(--band-content);
    text-decoration: none;
    font-weight: 600;
  }

  .menu :global(a[href]:hover),
  .menu :global(a[href]:focus-visible) {
    background-color: var(--band-content);
    color: var(--band-bg);
  }

  @media (width < 32.5rem) {
    .trigger {
      padding: 0.35rem 0.6rem;
      font-size: 0.85rem;
    }
  }
</style>
