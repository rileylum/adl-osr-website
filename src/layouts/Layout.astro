---
import '../assets/app.css';
import { ViewTransitions } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import OrganizationSchema from '../components/schemas/OrganizationSchema.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  showLogo?: boolean;
}

const {
  title = "OZ ORC 2026 - Adelaide's Premier Old-School RPG Convention",
  description = "Adelaide's premier old-school D&D and OSR gaming convention. Experience classic tabletop RPGs with expert GMs at Colonel Light Gardens RSL.",
  image,
  type,
  showLogo = true,
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      as="image"
      href="/images/OZORC_Dungeon-500w.webp"
      fetchpriority="high"
    />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} />
    <ViewTransitions />
    <!-- MailerLite Universal — account loader, required on every page. Astro's
         view transitions swap the document and drop universal.js's injected
         script, so instead of loading once we (re)load it on every
         astro:page-load whenever a .ml-embedded form on the page is still
         unrendered. A loading flag prevents concurrent injects and the watcher
         is registered once. See RegisterInterest.astro. -->
    <script is:inline>
      (function () {
        var w = window,
          d = document;
        function renderMailerLite() {
          var el = d.querySelector('.ml-embedded');
          if (!el || el.children.length) return; // nothing to do / already rendered
          if (w.__mlLoading) return; // a load is already in flight
          w.__mlLoading = true;
          // universal.js short-circuits when its own globals persist (it sets
          // __ml__initialized), so after a view transition it won't render the
          // freshly swapped-in embed. Clear its init globals and the prior script
          // so the reload fully re-initialises and renders the current
          // .ml-embedded.
          // Keep ml_jQuery (the loaded jQuery) so in-flight webforms code does
          // not throw; only clear what makes universal.js re-init and re-render.
          ['ml', '__ml__initialized', 'ml_guid'].forEach(function (k) {
            try {
              delete w[k];
            } catch {
              w[k] = undefined;
            }
          });
          var old = d.getElementById('ml-universal');
          if (old) old.remove();
          w.ml = function () {
            (w.ml.q = w.ml.q || []).push(arguments);
          };
          var s = d.createElement('script');
          s.id = 'ml-universal';
          s.async = 1;
          s.src = 'https://assets.mailerlite.com/js/universal.js';
          s.onload = s.onerror = function () {
            w.__mlLoading = false;
          };
          d.head.appendChild(s);
          w.ml('account', '2486872');
        }
        if (!w.__mlWatcher) {
          w.__mlWatcher = 1;
          d.addEventListener('astro:page-load', renderMailerLite);
        }
        renderMailerLite();
      })();
    </script>
  </head>
  <body>
    <Navbar showLogo={showLogo} />
    <main>
      <slot />
    </main>
    <Footer />
    <OrganizationSchema />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* Page transition animations */
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes slide-from-right {
    from {
      transform: translateX(30px);
    }
  }

  @keyframes slide-to-left {
    to {
      transform: translateX(-30px);
    }
  }

  /* Apply smooth fade transition to page content */
  ::view-transition-old(root) {
    animation:
      90ms cubic-bezier(0.4, 0, 1, 1) both fade-out,
      300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
  }

  ::view-transition-new(root) {
    animation:
      210ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in,
      300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
  }

  /* Smooth transition for dark mode changes */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      animation-duration: 0.5s;
    }
  }

  /* Logo morph transition between hero and navbar */
  ::view-transition-old(logo),
  ::view-transition-new(logo) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  ::view-transition-group(logo) {
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Respect user preferences for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
